  "launcher_source": "\"\"\"Run the unchanged benchmark with per-process imported-source and output identities.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path.cwd()))\n\nimport duckdb\nimport terrine\nfrom benchmarks import query_strategy_oracle, query_strategy_spike, workloads\n\n\ndef digest(path: Path) -> str:\n    with path.open(\"rb\") as stream:\n        return hashlib.file_digest(stream, \"sha256\").hexdigest()\n\n\ndef source_identity() -> dict:\n    production = Path(terrine.__file__).resolve().parent\n    helper = Path(query_strategy_spike.__file__).resolve()\n    fixture = Path(workloads.__file__).resolve()\n    oracle = Path(query_strategy_oracle.__file__).resolve()\n    return {\n        \"production_import\": str(Path(terrine.__file__).resolve()),\n        \"production_git_revision\": subprocess.check_output(\n            [\"git\", \"-C\", str(production.parent), \"rev-parse\", \"HEAD\"], text=True\n        ).strip(),\n        \"production_files\": {\n            str(path.relative_to(production)): digest(path)\n            for path in sorted(production.rglob(\"*.py\"))\n        },\n        \"helper_import\": str(helper), \"helper_sha256\": digest(helper),\n        \"fixture_import\": str(fixture), \"fixture_sha256\": digest(fixture),\n        \"oracle_import\": str(oracle), \"oracle_sha256\": digest(oracle),\n        \"duckdb\": duckdb.__version__,\n    }\n\n\noutput = Path(sys.argv[sys.argv.index(\"--output\") + 1])\nbefore = source_identity()\nprint(json.dumps({\"source_identity_before\": before}, sort_keys=True), flush=True)\nquery_strategy_spike.main()\nafter = source_identity()\nfor field in (\"production_files\", \"helper_sha256\", \"fixture_sha256\", \"oracle_sha256\"):\n    if before[field] != after[field]:\n        raise RuntimeError(f\"Benchmark source changed during execution: {field}\")\nrecords = {str(path.relative_to(output)): digest(path) for path in sorted(output.iterdir()) if path.is_file()}\nreceipt = {\n    \"source_before\": before, \"source_after\": after,\n    \"source_unchanged\": True, \"argv\": sys.argv[1:],\n    \"output_file_sha256\": records, \"launcher_source\": Path(__file__).read_text(),\n}\n(output / \"source-identity.json\").write_text(json.dumps(receipt, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({\"identity_verified\": True, \"output\": str(output), \"records\": len(records)}), flush=True)\n",
