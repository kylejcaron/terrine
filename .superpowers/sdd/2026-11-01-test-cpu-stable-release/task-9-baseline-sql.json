  "command": "import importlib.abc, importlib.util, json, subprocess, sys\nfrom pathlib import Path\nroot = Path.cwd()\npaths = ['terrine/backends/numeric.py', 'terrine/backends/dialect.py', 'terrine/backends/engines/duckdb.py', 'terrine/backends/engines/postgres.py', 'terrine/backends/engines/bigquery.py', 'terrine/backends/engines/snowflake.py', 'terrine/temporal/daily.py', 'terrine/temporal/prefix.py', 'terrine/temporal/aggregate.py', 'terrine/_refusal_codes.py']\nsources = {p[:-3].replace('/', '.'): (p, subprocess.run(['git', 'show', '13314bb:' + p], cwd=root, check=True, capture_output=True, text=True).stdout) for p in paths}\nclass Loader(importlib.abc.Loader):\n    def create_module(self, spec): return None\n    def exec_module(self, module):\n        p, source = sources[module.__name__]\n        exec(compile(source, str(root / p), 'exec'), module.__dict__)\nclass Finder(importlib.abc.MetaPathFinder):\n    def find_spec(self, fullname, path=None, target=None):\n        return importlib.util.spec_from_loader(fullname, Loader()) if fullname in sources else None\nsys.meta_path.insert(0, Finder())\nfrom benchmarks import run_overhead as b\ncon = b._connect(1)\ntry:\n    results = [b.run_case(w, con, repeats=1) for w in b.WORKLOADS]\nfinally:\n    con.disconnect()\nprint(json.dumps([{'case': r['case'], 'diagnostics': r['diagnostics'], 'oracle_match': r['oracle_match']} for r in results]))\n",
